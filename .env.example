# OpenAI 兼容 API 的密钥；使用本地或免鉴权服务时可留空。
OPENAI_API_KEY=
# OpenAI 兼容 API 的基础地址。
OPENAI_BASE_URL=https://api.openai.com/v1
# 调度 Agent 使用的模型名称。
OPENAI_MODEL=
# 单次 API 请求超时时间，单位为毫秒。
OPENAI_TIMEOUT_MS=30000
# 单次模型响应允许生成的最大 token 数。
OPENAI_MAX_TOKENS=65536
# 模拟随机种子；相同种子和相同决策会生成相同车流与随机事件。
SIMULATION_SEED=1
# warmup 之后固定运行的 tick 数；0 表示按决策周期数截止。命令行 --ticks 优先。
BENCH_HORIZON_TICKS=400
# false 时整场不生成行人，只用于估计完美规避行人事故时的得分上沿。
PEDESTRIAN_DEMAND_ENABLED=true

# 开局余额；最终余额即成绩。
INITIAL_BALANCE=1000
# 摩托车成功完成通行后的奖励。
TOLL_MOTORCYCLE=0.2
# 普通车辆成功完成通行后，每位乘员（重型货车按货物单位）的奖励；公交 40 人。
TOLL_STANDARD=0.1
# 警车、救护车、消防车等 emergency 类特殊车辆的通行奖励（按车计）。
TOLL_EMERGENCY=1
# 地图内普通实体车辆连续静止超过宽限期后，每位乘员每 tick 扣除的延误分。
DELAY_BLEED_PER_TICK=0.0002
# 实体车辆连续静止多少 tick 后开始扣延误；移动后重新计时。
WAITING_CHARGE_GRACE_TICKS=10
# 车道排满后滞留在地图外上游积压里的车辆，每位乘员每 tick 扣除的溢出分。
UPSTREAM_BLEED_PER_TICK=0.002
# 仿真截止时仍未服务（地图内等待或上游积压）的车辆，每位乘员扣一次的负债。
UNSERVED_VEHICLE_LIABILITY=0.1
# 每次调用模型进行决策的固定成本。
DECISION_TAX=0.02
# 每次非终结工具调用的固定成本。
TOOL_TAX=0.0015
# 未经成功 dry-run 验证而提交危险方案时的罚分。
RECKLESS_ATTEMPT_PENALTY=0.15
# 每个被事故或出口阻塞占用的冲突资源每 tick 的基础罚分。
HAZARD_BLEED_PER_RESOURCE=0.002
# 向事故已切断的路线继续抢行时，每辆车的罚分。
SECONDARY_ADMIT_PENALTY=0.3
# 每次派遣拖车的固定成本。
TOW_DISPATCH_COST=1.2
# 拖车从派遣到移除抛锚车辆所需的 tick 数。
TOW_CLEARANCE_TICKS=18
# 校车卷入事故时额外扣除的固定罚分。
SCHOOL_BUS_ACCIDENT_PENALTY=10
# 危化品罐车卷入事故时，其占用冲突资源的危险罚分倍数。
HAZMAT_HAZARD_MULTIPLIER=3
# 是否允许耐心耗尽的司机闯红灯、跟车闯入与加塞变道。
VEHICLE_AGGRESSION_ENABLED=true
# 排队车辆前方重新出现空位后，额外等待多少 tick 才起步。
STARTUP_LAG_TICKS=1
# 卡车和公交直行起步阶段需要慢速移动的步数。
SLOW_START_STEPS=2
# 停止线车辆累计等待多少 tick 后开始探头占用路口第一格。
CREEP_AFTER_WAITING_TICKS=8
# 出口临时停放窗口的候选周期，单位为 tick。
EXIT_HOLD_PERIOD=30
# 每次出口临时停放窗口持续的 tick 数。
EXIT_HOLD_DURATION=12
# 出口窗口的哈希命中模数；数值越小越容易出现，1 表示每个候选周期都出现。
EXIT_HOLD_MODULUS=5
# 右转斑马线占用窗口的候选周期，单位为 tick。
CROSSWALK_PERIOD=30
# 每次斑马线占用窗口持续的 tick 数。
CROSSWALK_DURATION=8
# 斑马线窗口的哈希命中模数；数值越小越容易出现，1 表示每个候选周期都出现。
CROSSWALK_MODULUS=4
# 非紧急车辆到达停止线时发生抛锚的哈希模数；数值越小越容易抛锚，1 表示必定抛锚。
STALL_MODULUS=17
# emergency 类特殊车辆进入停止线前 12 格且连续静止超过宽限期后，每 tick 的延误罚分。
EMERGENCY_DELAY_BLEED_PER_TICK=0.0015
# 停止线前 24 格内的车辆被抛锚车连续堵住多少 tick 后开始产生链式延误加价。
STALL_CHAIN_AFTER_TICKS=20
# 链式延误每多持续一个 tick，单车每 tick 增加的罚分。
STALL_CHAIN_STEP=0.0002
# 已放行车辆因入口受阻而累计顺延的 tick 上限；超过后本车及同车道后方的放行作废，车辆回到候选。
SCHEDULE_SLIDE_LIMIT_TICKS=20
# 同一模型响应中并行给出多个终结动作时的协议警告罚分。
PARALLEL_TERMINAL_WARNING_PENALTY=0.005

# 每个决策周期允许与模型交互的最大 API 轮数。
AGENT_MAX_API_ROUNDS=8
# 每个决策周期允许执行的最大工具调用数。
AGENT_MAX_TOOL_CALLS=12
# Agent 压缩历史中保留的最近决策周期数量。
AGENT_MEMORY_DEPTH=8
# 是否把 API 请求、响应、工具调用和结果写入日志文件。
AGENT_API_LOG=true
# 是否同时把 API 日志输出到终端。
AGENT_API_LOG_CONSOLE=true
# API 日志、报告和回放等运行产物的输出目录。
AGENT_API_LOG_DIR=logs
# 所有 API 日志、报告和工作记忆文件共用的可选后缀。
# 留空时使用开跑时刻的本地时间、毫秒和进程号，例如 164600123-4821。并行运行不会互相覆盖。
AGENT_ARTIFACT_POSTFIX=

# Jev（TypeSafe System One）密钥。设置 AI_GATEWAY_MODEL 后走 Jev 适配层，不再要求 OPENAI_*。
AI_GATEWAY_API_KEY=
# Jev API 根地址，请求会发到 {base}/v1/systemone。
AI_GATEWAY_BASE_URL=https://api.typesafe.ai
# Jev 模型名，例如 jev-latest。模型名以 jev 开头，或 OPENAI_BASE_URL 主机为 api.typesafe.ai 时也会选择 Jev。
AI_GATEWAY_MODEL=
