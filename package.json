{
  "name": "silicon-cop-bench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "tsc -p tsconfig.json && node dist/src/cli.js",
    "bench:runs": "tsc -p tsconfig.json && node scripts/bench-repeat.mjs",
    "bench:formal": "tsc -p tsconfig.json && node scripts/bench-repeat.mjs --parallel 6 --runs 100 --env .env.deepseek-flash --env .env.deepseek-v4-pro --env .env.mimo-v2.6-pro-ultraspeed -- --seed 63916 --plain",
    "replay:assets:prepare": "node scripts/prepare-release-model-assets.mjs",
    "replay:assets": "node scripts/copy-replay-assets.mjs",
    "replay:dev": "npm run replay:assets && npm --prefix apps/replay run dev",
    "replay:build": "npm run replay:assets && npm --prefix apps/replay run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^17.2.2",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "openai": "^5.20.3",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.31",
    "fbx2gltf": "^0.9.7-p1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
